{
    "label" : "lock",
    "action" : "swaylock -C /home/jusho/.config/swaylock/config -f",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "eyecare",
    "action" : "~/.config/waybar/wlsunset.sh --toggle",
    "text" : "Eye Care",
    "keybind" : "p"
}
{
    "label" : "wifi",
    "action" : "~/.config/sway/scripts/wifi-toggle.sh",
    "text" : "WiFi on/off",
    "keybind" : "w"
}
{
    "label" : "bluetooth",
    "action" : "~/.config/sway/scripts/bt-toggle.sh",
    "text" : "Bluetooth on/off",
    "keybind" : "b"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "Hibernate",
    "keybind" : "h"
}
{
    "label" : "logout",
    "action" : "niri msg action quit 2>/dev/null || loginctl terminate-session \"$XDG_SESSION_ID\"",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}