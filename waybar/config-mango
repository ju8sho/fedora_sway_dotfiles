{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "margin-top": 2,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left": ["dwl/tags"],
    "modules-center": ["dwl/window"],
    "modules-right": [
        "tray",
        "memory",
        "cpu",
        "custom/battery",
        "clock",
        "custom/power"
    ],

    "dwl/tags": {
        "num-tags": 9
    },

    "dwl/window": {
        "max-length": 50,
        "tooltip": false
    },

    "custom/battery": {
        "exec": "~/.config/waybar/battery.sh",
        "return-type": "json",
        "interval": 5
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "custom/power": {
        "format": "",
        "on-click": "~/.config/waybar/power-menu.sh",
        "tooltip": false
    }
}
