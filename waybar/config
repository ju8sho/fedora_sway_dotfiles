{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,
    "margin-top": 2,
    "margin-left": 6,
    "margin-right": 6,

    "modules-left": ["niri/workspaces", "wlr/taskbar"],
    "modules-center": ["clock"],
    "modules-right": [
        "memory",
        "cpu",
        "temperature",
        "custom/battery",
        "custom/tlp",
        "tray",
        "custom/notifications",
        "custom/power"
    ],

    "niri/workspaces": {
        "format": "{index}"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "on-click": "activate",
        "tooltip-format": "{title} | {app_id}"
    },

    "custom/battery": {
        "exec": "~/.config/waybar/battery.sh",
        "return-type": "json",
        "interval": 5
    },

    "custom/tlp": {
        "exec": "~/.config/waybar/tlp.sh --get",
        "return-type": "json",
        "interval": 10,
        "on-click": "~/.config/waybar/tlp.sh --info",
        "tooltip": true
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },

    "temperature": {
        "thermal-zone": 4,
        "warning-threshold": 80,
        "critical-threshold": 95,
        "format": "{temperatureC}°C",
        "interval": 10
    },

    "memory": {
        "format": "MEM {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8,
        "reverse-direction": false
    },

    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%A %d %B %Y}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt>{calendar}</tt>"
    },

    "custom/power": {
        "format": "",
        "on-click": "~/.config/waybar/power-menu.sh",
        "tooltip": false
    },

    "custom/notifications": {
        "exec": "~/.config/waybar/notifications.sh --get",
        "return-type": "json",
        "interval": 5,
        "on-click": "~/.config/waybar/notifications.sh --show",
        "tooltip": true
    }
}