# swaylock-effects - Example theme (teal starter)
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - JetBrains Darcula: blue 6897BB, orange CC7832, red FF6B68
ring-color=61afefff
inside-color=21252b66
text-color=abb2bfff
key-hl-color=d19a66ff
bs-hl-color=e06c75ff
ring-ver-color=98c379ff
inside-ver-color=21252b66
text-ver-color=98c379ff
ring-clear-color=e5c07bff
inside-clear-color=21252b66
text-clear-color=e5c07bff
caps-lock-key-hl-color=d19a66ff
caps-lock-bs-hl-color=e06c75ff
ring-wrong-color=e06c75ff
inside-wrong-color=21252b66
text-wrong-color=e06c75ff
line-uses-ring
separator-color=00000000
layout-text-color=abb2bfff
