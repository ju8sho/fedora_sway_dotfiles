# swaylock-effects - Purple theme
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: purple 5c2a99, pink a81a6b, red ff4141
ring-color=5c2a99ff
inside-color=f4f0f866
text-color=5c2a99ff
key-hl-color=d8a5ffff
bs-hl-color=4a1a7aff
ring-ver-color=9d5cffff
inside-ver-color=f4f0f866
text-ver-color=9d5cffff
ring-clear-color=a81a6bff
inside-clear-color=f4f0f866
text-clear-color=a81a6bff
caps-lock-key-hl-color=d8a5ffff
caps-lock-bs-hl-color=4a1a7aff
ring-wrong-color=ff4141ff
inside-wrong-color=f4f0f866
text-wrong-color=ff4141ff
line-uses-ring
separator-color=ffffff00
layout-text-color=5c2a99ff
