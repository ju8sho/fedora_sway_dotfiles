# swaylock-effects - Example theme (teal starter)
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - JetBrains Darcula: blue 6897BB, orange CC7832, red FF6B68
ring-color=6897bbff
inside-color=1e1f2266
text-color=a9b7c6ff
key-hl-color=cc7832ff
bs-hl-color=ff6b68ff
ring-ver-color=6a8759ff
inside-ver-color=1e1f2266
text-ver-color=6a8759ff
ring-clear-color=e8bf6aff
inside-clear-color=1e1f2266
text-clear-color=e8bf6aff
caps-lock-key-hl-color=cc7832ff
caps-lock-bs-hl-color=ff6b68ff
ring-wrong-color=ff6b68ff
inside-wrong-color=1e1f2266
text-wrong-color=ff6b68ff
line-uses-ring
separator-color=00000000
layout-text-color=a9b7c6ff
