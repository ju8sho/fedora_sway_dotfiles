# swaylock-effects - Example theme (teal starter)
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - JetBrains Darcula: blue 6897BB, orange CC7832, red FF6B68
ring-color=83a598ff
inside-color=1d202166
text-color=ebddb2ff
key-hl-color=fe8019ff
bs-hl-color=fb4934ff
ring-ver-color=98971aff
inside-ver-color=1d202166
text-ver-color=98971aff
ring-clear-color=fabd2fff
inside-clear-color=1d202166
text-clear-color=fabd2fff
caps-lock-key-hl-color=fe8019ff
caps-lock-bs-hl-color=fb4934ff
ring-wrong-color=fb4934ff
inside-wrong-color=1d202166
text-wrong-color=fb4934ff
line-uses-ring
separator-color=00000000
layout-text-color=ebddb2ff
