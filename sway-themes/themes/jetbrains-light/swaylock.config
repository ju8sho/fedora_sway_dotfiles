# swaylock-effects - IntelliJ Light theme
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - IntelliJ Light: blue 3B6EA5, orange CC7832, red D23B3B
ring-color=3b6ea5ff
inside-color=f7f7f7cc
text-color=1e1e1fff
key-hl-color=cc7832ff
bs-hl-color=d23b3bff
ring-ver-color=4a7d3aff
inside-ver-color=f7f7f7cc
text-ver-color=4a7d3aff
ring-clear-color=aa8a00ff
inside-clear-color=f7f7f7cc
text-clear-color=aa8a00ff
caps-lock-key-hl-color=cc7832ff
caps-lock-bs-hl-color=d23b3bff
ring-wrong-color=d23b3bff
inside-wrong-color=f7f7f7cc
text-wrong-color=d23b3bff
line-uses-ring
separator-color=00000000
layout-text-color=1e1e1fff