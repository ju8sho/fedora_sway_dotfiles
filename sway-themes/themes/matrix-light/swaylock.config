# swaylock-effects - Matrix theme
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: green 0d7a2c, yellow e5ff41, red ff4141
ring-color=0d7a2cff
inside-color=f2f5f366
text-color=0d7a2cff
key-hl-color=4a8a1dff
bs-hl-color=0c8a2aff
ring-ver-color=0b8a3dff
inside-ver-color=f2f5f366
text-ver-color=0b8a3dff
ring-clear-color=e5ff41ff
inside-clear-color=f2f5f366
text-clear-color=e5ff41ff
caps-lock-key-hl-color=4a8a1dff
caps-lock-bs-hl-color=0c8a2aff
ring-wrong-color=ff4141ff
inside-wrong-color=f2f5f366
text-wrong-color=ff4141ff
line-uses-ring
separator-color=ffffff00
layout-text-color=0d7a2cff
