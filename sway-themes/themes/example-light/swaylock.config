# swaylock-effects - Example theme (teal starter)
# Blurred live screenshot of the desktop as lock background
screenshots
effect-blur=14x6
effect-vignette=0.2:0.6
fade-in=0.25

# Clock inside the indicator ring
clock
timestr=%H:%M
datestr=%a %e %b
font=JetBrainsMono Nerd Font

indicator
indicator-radius=110
indicator-thickness=8
ignore-empty-password

# Colors (RRGGBBAA) - family: purple 0d8677, pink 8a6a10, red ff4141
ring-color=0d8677ff
inside-color=f0f8f666
text-color=0d8677ff
key-hl-color=2c6e60ff
bs-hl-color=00997dff
ring-ver-color=0d7d6dff
inside-ver-color=f0f8f666
text-ver-color=0d7d6dff
ring-clear-color=8a6a10ff
inside-clear-color=f0f8f666
text-clear-color=8a6a10ff
caps-lock-key-hl-color=2c6e60ff
caps-lock-bs-hl-color=00997dff
ring-wrong-color=ff4141ff
inside-wrong-color=f0f8f666
text-wrong-color=ff4141ff
line-uses-ring
separator-color=ffffff00
layout-text-color=0d8677ff
