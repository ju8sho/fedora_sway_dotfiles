# ============================================================
# Sway — clean daily-driver config
# JetBrains / Darcula style + simple dynamic tiling
# ============================================================

### Core
set $mod Mod4
set $left h
set $down j
set $up k
set $right l

set $term kitty
set $menu rofi -show drun

include /etc/sway/config-vars.d/*

### ============================================================
### Tiling / layout
### ============================================================

# Yangi tiled containerlar uchun avtomatik yo'nalish.
# Sway ekran nisbatiga qarab horizontal/vertical splitni tanlaydi.
default_orientation auto

# Bo'sh workspace'da oddiy tiling ishlatiladi.
workspace_layout default

# Har bir oynani biroz ajratib turadi.
gaps inner 2
gaps outer 0

# Bitta oyna turganda border/gapni kamaytiradi — ekran toza ko'rinadi.
smart_borders on
smart_gaps on
hide_edge_borders smart

# Titlebar yo'q, faqat ingichka border.
default_border pixel 2
default_floating_border pixel 2

### ============================================================
### Appearance
### ============================================================

font pango:JetBrainsMono Nerd Font 10

# Ranglar ~/.config/sway-themes/current dan olinadi.
include ~/.config/sway-themes/current/sway-colors.conf

### ============================================================
### Input
### ============================================================

input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
    middle_emulation enabled
    pointer_accel 0.4
    accel_profile adaptive
}

### ============================================================
### Startup
### ============================================================

# Wallpaper: user tanlagan rasm (custom.png) yoki tema rasmi.
# exec_always + sleep: boot'da output hali tayyor emas, 2 soniyadan keyin
# swaybg ishga tushadi; rasmsiz eski jarayon qolsa ham power-script
# (5s da battery.sh orqali) uni tuzatadi.
exec_always sh -c 'sleep 2; ~/.config/sway/scripts/wallpaper-power.sh'

# Ko'z himoyasi.
exec_always sh -c 'pkill -x wlsunset 2>/dev/null; sleep 0.3; wlsunset -l 41.31 -L 69.24 -t 4000 -T 6500 &'

# Lock + suspend.
exec_always sh -c "pkill -x swayidle 2>/dev/null; swayidle -w timeout 1800 '$HOME/.local/bin/swaylock -f' timeout 3600 'systemctl suspend' before-sleep '$HOME/.local/bin/swaylock -f' &"

# Waybar. Reload paytida eski instance yopiladi.
exec_always sh -c 'pkill -x waybar 2>/dev/null; waybar -c ~/.config/waybar/config-active &'

# Aktiv bo'lmagan oynalar biroz shaffof; fokusli oyna to'liq ko'rinadi.
exec_always sh -c '~/.config/sway/scripts/inactive-opacity.sh &'

# GNOME keyring.
exec gnome-keyring-daemon --start --components=secrets

# Clipboard history.
exec_always sh -c 'pkill -f "wl-paste --type text --watch cliphist store" 2>/dev/null; command -v cliphist >/dev/null 2>&1 && wl-paste --type text --watch cliphist store &'

### ============================================================
### Floating windows
### ============================================================

# Dialog/menu kabi oynalar tilingni buzmasin.
for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [window_role="Preferences"] floating enable
for_window [window_role="About"] floating enable
for_window [window_type="dialog"] floating enable
for_window [window_type="menu"] floating enable

# Network manager terminali uchun qulay floating oyna.
for_window [app_id="nmtui"] floating enable, resize set 700 500

### ============================================================
### Mouse / floating modifier
### ============================================================

floating_modifier $mod normal

### ============================================================
### Basic actions
### ============================================================

bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload

bindsym $mod+Shift+e exec swaynag -t warning -m 'Sway sessiyasidan chiqilsinmi?' -B 'Ha, chiqish' 'swaymsg exit'

# Floating toggle.
bindsym $mod+Shift+space floating toggle

# Fullscreen.
bindsym $mod+f fullscreen toggle

# Floating/tiling layer o'rtasida focus.
bindsym $mod+space focus mode_toggle

### ============================================================
### Focus
### ============================================================

# Vim-style.
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

# Arrow keys.
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Parent container.
bindsym $mod+a focus parent

### ============================================================
### Move windows
### ============================================================

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

### ============================================================
### Workspaces
### ============================================================

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

# Bir workspace'ni ikki marta bossang oldingisiga qaytadi.
workspace_auto_back_and_forth yes

### ============================================================
### Layout controls
### ============================================================

# Qo'lda split qilish.
bindsym $mod+b splith
bindsym $mod+v splitv

# Tiling layoutini almashtirish.
bindsym $mod+e layout toggle split

# Kam ishlatiladigan layoutlar.
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed

### ============================================================
### Scratchpad
### ============================================================

bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

### ============================================================
### Resize mode
### ============================================================

mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"

### ============================================================
### Custom utilities
### ============================================================

# Wallpaper picker.
bindsym $mod+Shift+w exec ~/.config/sway/scripts/wallpaper-pick.sh

# Dark/light theme.
bindsym $mod+t exec ~/.config/sway/scripts/theme-picker.sh

# Volume.
bindsym XF86AudioRaiseVolume exec ~/.config/sway/scripts/volume.sh up
bindsym XF86AudioLowerVolume exec ~/.config/sway/scripts/volume.sh down
bindsym XF86AudioMute exec ~/.config/sway/scripts/volume.sh mute

# Brightness.
bindsym XF86MonBrightnessUp exec ~/.config/sway/scripts/brightness.sh up
bindsym XF86MonBrightnessDown exec ~/.config/sway/scripts/brightness.sh down

# Clipboard picker.
bindsym $mod+Shift+v exec sh -c 'command -v cliphist >/dev/null 2>&1 && cliphist list | rofi -dmenu -i -p "clipboard" | cliphist decode | wl-copy'

# Screenshot: selected area -> clipboard.
bindsym --release Print exec sh -c 'grim -g "$(slurp)" - | wl-copy --type image/png'

# Screenshot: whole screen -> clipboard.
bindsym --release $mod+Print exec sh -c 'grim - | wl-copy --type image/png'

# Lock.
bindsym --release Mod4+semicolon exec ~/.local/bin/swaylock -f --effect-blur 4x2

# Lock + suspend.
bindsym --release Mod4+l exec ~/.local/bin/swaylock -f && systemctl suspend

### ============================================================
### System config
### ============================================================

# Fedora Sway'ning system configlari.
include /etc/sway/config.d/*
